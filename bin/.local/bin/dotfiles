#!/usr/bin/env bash

set -euo pipefail

REPO="${DOTFILES_DIR:-$HOME/dotfiles}"
PACKAGES=(bin ghostty git mise nvim starship zsh)

usage() {
  cat <<'EOF'
Usage: dotfiles <command>

Commands:
  status   Show repository changes
  sync     Recreate all symlinks
  update   Pull, install dependencies, sync, and update Neovim
  doctor   Verify required commands and managed links
  check    Run all repository checks
  help     Show this message
EOF
}

case "${1:-help}" in
  status)
    git -C "$REPO" status --short --branch
    ;;
  sync)
    stow --dir="$REPO" --target="$HOME" --restow "${PACKAGES[@]}"
    ;;
  update)
    git -C "$REPO" pull --rebase
    brew bundle --file="$REPO/Brewfile"
    stow --dir="$REPO" --target="$HOME" --restow "${PACKAGES[@]}"
    nvim --headless "+Lazy! sync" +qa
    "$REPO/scripts/check.sh"
    ;;
  doctor)
    failed=0
    for command_name in \
      git \
      gh \
      stow \
      mise \
      nvim \
      starship \
      fzf \
      zoxide \
      eza \
      bat \
      delta \
      lazygit \
      rg \
      fd \
      gitleaks \
      actionlint \
      shellcheck \
      shfmt \
      stylua; do
      if command -v "$command_name" >/dev/null 2>&1; then
        printf 'ok      %s\n' "$command_name"
      else
        printf 'missing %s\n' "$command_name"
        failed=1
      fi
    done

    if [[ -d "/Applications/Ghostty.app" ]]; then
      printf 'ok      %s\n' "Ghostty.app"
    else
      printf 'missing %s\n' "Ghostty.app"
      failed=1
    fi

    managed_targets=(
      "$HOME/.local/bin/dotfiles"
      "$HOME/.zshrc"
      "$HOME/.gitconfig"
      "$HOME/.config/ghostty"
      "$HOME/.config/mise"
      "$HOME/.config/nvim"
      "$HOME/.config/starship.toml"
    )
    managed_sources=(
      "$REPO/bin/.local/bin/dotfiles"
      "$REPO/zsh/.zshrc"
      "$REPO/git/.gitconfig"
      "$REPO/ghostty/.config/ghostty"
      "$REPO/mise/.config/mise"
      "$REPO/nvim/.config/nvim"
      "$REPO/starship/.config/starship.toml"
    )

    for index in "${!managed_targets[@]}"; do
      target="${managed_targets[$index]}"
      source="${managed_sources[$index]}"
      if [[ -e "$target" && "$target" -ef "$source" ]]; then
        printf 'managed %s\n' "$target"
      else
        printf 'unmanaged %s\n' "$target"
        failed=1
      fi
    done
    unset managed_targets managed_sources target source index
    exit "$failed"
    ;;
  check)
    exec "$REPO/scripts/check.sh"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
